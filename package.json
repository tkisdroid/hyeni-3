{
  "name": "hyeni-calendar",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "description": "혜니캘린더 — 가족 일정 공유 + 부모·자녀 위치/안전 (리디자인)",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-capacitor-systembars.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-route-bundle.mjs",
    "test": "node --test tests/*.test.*",
    "test:worker": "node --test worker/tests/*.test.mjs",
    "typecheck:worker": "tsc -p worker --noEmit",
    "deploy:worker": "cd worker && wrangler deploy",
    "verify": "npm run typecheck && npm run build && npm test",
    "verify:production:web-push": "node scripts/verify-production-web-push-secrets.mjs",
    "verify:route-bundle": "node scripts/verify-route-bundle.mjs",
    "qa:browser": "node scripts/final-browser-qa.mjs",
    "qa:pwa-runtime": "node scripts/pwa-runtime-qa.mjs",
    "release:pages-provenance": "node scripts/create-pages-provenance.mjs",
    "release:aab-evidence": "node scripts/create-aab-evidence.mjs",
    "release:record": "node scripts/create-release-record.mjs",
    "release:play-store-assets": "node scripts/create-play-store-final-assets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@tanstack/react-query": "^5.101.2",
    "lucide-react": "^0.469.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "hono": "4.12.34",
    "jose": "^6.2.3",
    "sharp": "^0.35.3",
    "typescript": "^5.7.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.0.0",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
