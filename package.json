{
  "name": "hyeni-calendar",
  "private": true,
  "version": "1.4.5",
  "type": "module",
  "description": "혜니캘린더 — 가족 일정 공유 + 부모·자녀 위치/안전 (리디자인)",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-capacitor-systembars.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/write-oauth-callback-entry.mjs && node scripts/verify-route-bundle.mjs",
    "test": "node --test tests/*.test.*",
    "i18n:build": "node scripts/i18n/build-catalogs.mjs",
    "i18n:manifests": "node scripts/i18n/generate-pwa-manifests.mjs",
    "i18n:scan": "node scripts/i18n/scan-user-facing-literals.mjs",
    "i18n:verify": "node scripts/i18n/validate-catalogs.mjs --check-generated && node scripts/i18n/generate-pwa-manifests.mjs --check && node scripts/i18n/generate-android-locales.mjs --check && node scripts/i18n/scan-user-facing-literals.mjs && node scripts/i18n/scan-client-error-surfaces.mjs",
    "test:worker": "node --import ./worker/tests/helpers/tsModuleResolve.mjs --test worker/tests/*.test.mjs",
    "typecheck:worker": "tsc -p worker --noEmit",
    "deploy:worker": "cd worker && wrangler deploy",
    "verify": "npm run build && npm test",
    "verify:production:worker-secrets": "node scripts/verify-production-worker-secrets.mjs",
    "verify:production:web-push": "node scripts/verify-production-web-push-secrets.mjs",
    "verify:google-maps:readiness": "node scripts/verify-google-maps-release-readiness.mjs",
    "verify:google-maps:release": "node scripts/verify-google-maps-release-readiness.mjs --release",
    "verify:route-bundle": "node scripts/verify-route-bundle.mjs",
    "qa:browser": "node scripts/final-browser-qa.mjs",
    "capture:screen": "node scripts/capture-screen.mjs",
    "qa:ai-voice": "node scripts/verify-ai-friend-voice-reply.mjs",
    "qa:pwa-runtime": "node scripts/pwa-runtime-qa.mjs",
    "android:install:debug": "node scripts/install-android-debug.mjs",
    "ios:sync": "npm run build && cap sync ios && node scripts/normalize-capacitor-ios-spm.mjs && npm run verify:ios",
    "verify:ios": "node scripts/verify-ios-packaging.mjs",
    "release:pages-provenance": "node scripts/create-pages-provenance.mjs",
    "release:aab-evidence": "node scripts/create-aab-evidence.mjs",
    "release:record": "node scripts/create-release-record.mjs",
    "release:play-store-assets": "node scripts/create-play-store-final-assets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "i18n:android": "node scripts/i18n/generate-android-locales.mjs",
    "store:listing": "node scripts/store/build-global-listing.mjs",
    "store:listing:check": "node scripts/store/build-global-listing.mjs --check"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.4.1",
    "@capacitor/google-maps": "8.0.1",
    "@capacitor/ios": "^8.4.1",
    "@googlemaps/js-api-loader": "2.1.1",
    "@tanstack/react-query": "^5.101.2",
    "intl-messageformat": "11.2.13",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.469.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-intl": "10.1.20",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@formatjs/cli": "6.16.16",
    "@formatjs/icu-messageformat-parser": "3.5.16",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "hono": "4.12.34",
    "jose": "^6.2.3",
    "sharp": "^0.35.3",
    "typescript": "^5.7.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.0.0",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
