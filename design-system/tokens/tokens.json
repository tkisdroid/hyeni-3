{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "혜니캘린더 Design Tokens",
    "version": "1.0.0",
    "source": "혜니캘린더 리디자인 prototype",
    "note": "Literal values, platform-agnostic. Compatible with Style Dictionary / Tokens Studio."
  },
  "color": {
    "rose":     { "50": "#FFF0F5", "soft": "#FDE7F1", "line": "#FFD0DD", "light": "#FF9EC4", "base": "#F779A8", "brand": "#F76BA6", "deep": "#F0518F", "text": "#B0477A" },
    "mint":     { "soft": "#E7F8F0", "line": "#BCEBD8", "light": "#46D19B", "base": "#31C48D", "deep": "#23A876", "text": "#087653" },
    "lavender": { "soft": "#F1ECFF", "soft2": "#EFE8FF", "line": "#DDD1FF", "light": "#B79DFB", "base": "#A78BFA", "mid": "#8B6BEC", "deep": "#7C5CE1", "text": "#6D4E9C" },
    "gold":     { "soft": "#FFF3D6", "base": "#FFD76A", "deep": "#E08A1E", "text": "#8A6A1E" },
    "blue":     { "soft": "#E6F2FB", "base": "#2E86C1", "text": "#2E6DA4" },
    "danger":   { "soft": "#FFECEE", "base": "#E5484D", "strong": "#F04770", "text": "#B91C1C" },
    "fg":       { "primary": "#201A1D", "secondary": "#4A4145", "body": "#3A3236", "tertiary": "#6D6469", "muted": "#8B7E84", "faint": "#A99FA4", "disabled": "#C9BFC4" },
    "line":     { "hair": "rgba(32,26,29,0.06)", "soft": "rgba(32,26,29,0.10)", "strong": "rgba(32,26,29,0.16)" },
    "bg":       { "app": "#FBF7F4", "page": "#F7F4F3", "body": "#EFE7EE", "card": "#FFFFFF", "press": "#FBF3F6" }
  },
  "typography": {
    "fontFamily": "\"Pretendard Variable\", \"Pretendard\", -apple-system, \"Apple SD Gothic Neo\", \"Malgun Gothic\", sans-serif",
    "weight": { "medium": 500, "semibold": 600, "bold": 700, "heavy": 800, "black": 900 },
    "scale": {
      "display":  { "size": 44,   "weight": 900, "line": 1.0,  "tracking": "-0.03em", "use": "balance / big number" },
      "titleXl":  { "size": 26,   "weight": 800, "line": 1.28, "tracking": "-0.02em", "use": "home hero" },
      "title":    { "size": 25,   "weight": 900, "line": 1.28, "tracking": "-0.02em", "use": "screen title" },
      "section":  { "size": 17,   "weight": 800, "line": 1.3,  "tracking": "-0.02em", "use": "section heading" },
      "bodyLg":   { "size": 16,   "weight": 700, "line": 1.3,  "use": "primary button label" },
      "body":     { "size": 15,   "weight": 700, "line": 1.4,  "use": "list item title" },
      "bodySm":   { "size": 14,   "weight": 600, "line": 1.5,  "use": "body text" },
      "label":    { "size": 12.5, "weight": 700, "use": "inline link / strong meta" },
      "caption":  { "size": 12,   "weight": 600, "use": "meta" },
      "micro":    { "size": 11,   "weight": 700, "use": "badge" },
      "tiny":     { "size": 10.5, "weight": 800, "use": "chip" }
    }
  },
  "radius":  { "xs": 8, "sm": 10, "md": 13, "lg": 15, "xl": 18, "2xl": 20, "card": 24, "hero": 26, "3xl": 30, "pill": 9999 },
  "spacing": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "sectionChild": 18, "pagePadding": 20 },
  "shadow": {
    "soft":     "0 4px 12px rgba(32,26,29,0.06)",
    "card":     "0 14px 34px -18px rgba(32,26,29,0.22), 0 2px 6px rgba(32,26,29,0.04)",
    "floating": "0 12px 30px rgba(32,26,29,0.10), 0 2px 6px rgba(32,26,29,0.05)",
    "rose":     "0 22px 42px -16px rgba(240,81,143,0.55)",
    "roseButton": "0 12px 24px -8px rgba(240,81,143,0.50)",
    "mint":     "0 12px 24px -10px rgba(35,168,118,0.55)",
    "lavender": "0 16px 32px -12px rgba(124,92,225,0.60)"
  },
  "motion": {
    "duration": { "fast": 120, "base": 160, "screen": 400 },
    "easing":   { "standard": "cubic-bezier(0.2,0,0.2,1)", "cheer": "cubic-bezier(0.34,1.56,0.64,1)" },
    "pressScale": 0.96
  },
  "feelModes": {
    "depth":  ["soft", "flat"],
    "vibe":   ["pastel", "base", "pop"],
    "motion": ["lively", "calm"]
  }
}
