<?xml version="1.0" encoding="utf-8"?>
<!-- 전체화면 알림 공통 카드 surface. radius 26dp, stroke + 카드 배경.
     색은 colors.xml/values-night 의 alert_card_* 토큰 참조. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/alert_card_bg" />
    <corners android:radius="26dp" />
    <stroke
        android:width="1dp"
        android:color="@color/alert_card_line" />
</shape>
