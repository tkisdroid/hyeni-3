# ── 혜니캘린더 환경설정 (hyeni-1에서 이관) ─────────────────────────────────
# Cloudflare Worker API base (백엔드 = D1/R2/Durable Objects Worker).
# 미설정 시 prod Worker 기본값 사용(src/lib/api/client.ts).
VITE_API_BASE=https://hyeni-calendar-api.tkisdroid.workers.dev

# Kakao 지도 JS 앱키(클라). REST 키는 Worker secret(KAKAO_REST_KEY), 절대 VITE_ 금지.
VITE_KAKAO_APP_KEY=

# Naver 소셜 로그인 Client ID. Secret은 Worker secret에만.
# redirect_uri = {VITE_API_BASE}/api/auth/naver
VITE_NAVER_CLIENT_ID=

# Qonversion + Google Play Billing (구독/페이월)
VITE_QONVERSION_PROJECT_KEY=
VITE_QONVERSION_ENVIRONMENT=sandbox
VITE_QONVERSION_ENTITLEMENT_ID=premium
VITE_QONVERSION_KIDS_MODE=true
VITE_QONVERSION_PROXY_URL=
